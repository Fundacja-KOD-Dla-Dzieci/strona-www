# Przykładowe environment variables dla Cloudflare Pages
# NIE COMMITUJ tego pliku z prawdziwymi wartościami!

# Resend API Key (z https://resend.com)
# Uzyskaj klucz z: https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_API_KEY_HERE

# Email docelowy dla formularza kontaktowego
CONTACT_EMAIL=kontakt@fundacjakod.pl

# Uwaga: Te zmienne należy ustawić w Cloudflare Dashboard:
# Pages → Settings → Environment Variables
# NIE ustawiaj ich w tym pliku dla produkcji!
